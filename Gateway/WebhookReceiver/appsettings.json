{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "LogLevel": {
        "Microsoft": "Warning"
      },
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "HH:mm:ss ",
        "IncludeScopes": false,
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*"
}